  "functions": [
    {
      "name": "create_freight_demand_for_prod",
      "definition": "CREATE OR REPLACE FUNCTION public.create_freight_demand_for_prod()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n  target_contract public.production_contracts%rowtype;\r\nbegin\r\n  select *\r\n    into target_contract\r\n  from public.production_contracts\r\n  where id = new.contract_id\r\n    and company_id = new.company_id;\r\n\r\n  if target_contract.id is null then\r\n    return new;\r\n  end if;\r\n\r\n  insert into public.freight_demands (\r\n    company_id,\r\n    prod_id,\r\n    contract_id,\r\n    client_id,\r\n    planned_date,\r\n    status,\r\n    created_by\r\n  )\r\n  values (\r\n    new.company_id,\r\n    new.id,\r\n    target_contract.id,\r\n    target_contract.client_id,\r\n    null,\r\n    'previsto',\r\n    new.created_by\r\n  )\r\n  on conflict (prod_id) do nothing;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "initialize_prod_defaults",
      "definition": "CREATE OR REPLACE FUNCTION public.initialize_prod_defaults()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  insert into public.production_prod_stages (company_id, prod_id, stage_id, planned_date)\r\n  select new.company_id, new.id, s.id, new.planned_end_date\r\n  from public.production_stages s\r\n  where s.company_id = new.company_id\r\n    and s.active\r\n  on conflict do nothing;\r\n\r\n  insert into public.production_prod_materials (company_id, prod_id, material_group)\r\n  select new.company_id, new.id, mg.key\r\n  from public.production_material_groups mg\r\n  where mg.company_id = new.company_id\r\n    and mg.active\r\n  on conflict do nothing;\r\n\r\n  insert into public.production_prod_document_checks (company_id, prod_id, checklist_item_id)\r\n  select new.company_id, new.id, item.id\r\n  from public.production_document_checklist_items item\r\n  where item.company_id = new.company_id\r\n    and item.active\r\n  on conflict do nothing;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    }
  ]
}
